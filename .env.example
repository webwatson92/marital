# Copier ce fichier en .env pour construire le site sur votre ordinateur.
# Sur Netlify, ces valeurs se renseignent dans : Site configuration > Environment variables.

# URL du projet Supabase (Project Settings > API)
SUPABASE_URL=https://VOTRE-PROJET.supabase.co

# Clé PUBLIQUE du projet : « anon public » (eyJ...) ou « publishable » (sb_publishable_...)
# Ne JAMAIS mettre ici la clé « service_role » / « secret ».
SUPABASE_ANON_KEY=

# Adresse publique du site (facultatif sur Netlify, qui la fournit automatiquement)
SITE_URL=https://mariage-ouattara-kante.netlify.app
